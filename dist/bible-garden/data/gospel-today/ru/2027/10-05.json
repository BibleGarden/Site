{"calendar":"julian","date":"2027-10-05","day":{"confirmed_by":[],"items":[{"apostle":"p-01ac42a049ff4fc7","gospel":"p-f4dc11eb8ed755b9","kind":"ordinary"}],"period":"ordinary","uncertain":false},"passages":{"p-01ac42a049ff4fc7":{"audio":null,"book":48,"book_name":"Послание к Галатам","display_ranges":[[5,11,5,21]],"label":"Гал 5:11–21","ranges":[[5,11,5,21]],"verses":[{"chapter":5,"first":11,"last":11,"text":"За что же гонят меня, братия, если я и теперь проповедую обрезание? Тогда соблазн креста прекратился бы."},{"chapter":5,"first":12,"last":12,"text":"О, если бы удалены были возмущающие вас!"},{"chapter":5,"first":13,"last":13,"text":"К свободе призваны вы, братия, только бы свобода ваша не была поводом к угождению плоти, но любовью служи́те друг другу."},{"chapter":5,"first":14,"last":14,"text":"Ибо весь закон в одном слове заключается: люби ближнего твоего, как самого себя."},{"chapter":5,"first":15,"last":15,"text":"Если же друг друга угрызаете и съедаете, берегитесь, чтобы вы не были истреблены друг другом."},{"chapter":5,"first":16,"last":16,"text":"Я говорю: поступайте по духу, и вы не будете исполнять вожделений плоти,"},{"chapter":5,"first":17,"last":17,"text":"ибо плоть желает противного духу, а дух — противного плоти: они друг другу противятся, так что вы не то делаете, что хотели бы."},{"chapter":5,"first":18,"last":18,"text":"Если же вы духом водитесь, то вы не под законом."},{"chapter":5,"first":19,"last":19,"text":"Дела плоти известны; они суть: прелюбодеяние, блуд, нечистота, непотребство,"},{"chapter":5,"first":20,"last":20,"text":"идолослужение, волшебство, вражда, ссоры, зависть, гнев, распри, разногласия, (соблазны,) ереси,"},{"chapter":5,"first":21,"last":21,"text":"ненависть, убийства, пьянство, бесчинство и тому подобное. Предваряю вас, как и прежде предварял, что поступающие так Царствия Божия не наследуют."}]},"p-f4dc11eb8ed755b9":{"audio":{"chapters":[3,4],"segments":[{"begin":265.62,"chapter":3,"end":276.38},{"begin":277.12,"chapter":3,"end":285.52},{"begin":286.42,"chapter":3,"end":293.0},{"begin":293.88,"chapter":3,"end":300.66},{"begin":302.11,"chapter":3,"end":309.17},{"begin":310.22,"chapter":3,"end":317.25},{"begin":318.17,"chapter":3,"end":325.81},{"begin":326.74,"chapter":3,"end":332.77},{"begin":333.39,"chapter":3,"end":340.23},{"begin":341.09,"chapter":3,"end":347.62},{"begin":348.71,"chapter":3,"end":355.09},{"begin":356.09,"chapter":3,"end":361.82},{"begin":362.77,"chapter":3,"end":368.86},{"begin":369.58,"chapter":3,"end":375.21},{"begin":376.18,"chapter":3,"end":382.08},{"begin":382.88,"chapter":3,"end":388.7},{"begin":6.2,"chapter":4,"end":13.12}],"translation":"syn","voice":"prudovsky"},"book":42,"book_name":"Евангелие от Луки","display_ranges":[[3,23,4,1]],"label":"Лк 3:23–4:1","ranges":[[3,23,4,1]],"verses":[{"chapter":3,"first":23,"last":23,"text":"Иисус, начиная Своё служение, был лет тридцати, и был, как думали, Сын Иосифов, Илиев,"},{"chapter":3,"first":24,"last":24,"text":"Матфатов, Левиин, Мелхиев, Ианнаев, Иосифов,"},{"chapter":3,"first":25,"last":25,"text":"Маттафиев, Амосов, Наумов, Еслимов, Наггеев,"},{"chapter":3,"first":26,"last":26,"text":"Маафов, Маттафиев, Семеиев, Иосифов, Иудин,"},{"chapter":3,"first":27,"last":27,"text":"Иоаннанов, Рисаев, Зоровавелев, Салафиилев, Нириев,"},{"chapter":3,"first":28,"last":28,"text":"Мелхиев, Аддиев, Косамов, Елмодамов, Иров,"},{"chapter":3,"first":29,"last":29,"text":"Иосиев, Елиезеров, Иоримов, Матфатов, Левиин,"},{"chapter":3,"first":30,"last":30,"text":"Симеонов, Иудин, Иосифов, Ионанов, Елиакимов,"},{"chapter":3,"first":31,"last":31,"text":"Мелеаев, Маинанов, Маттафаев, Нафанов, Давидов,"},{"chapter":3,"first":32,"last":32,"text":"Иессеев, Овидов, Воозов, Салмонов, Наассонов,"},{"chapter":3,"first":33,"last":33,"text":"Аминадавов, Арамов, Есромов, Фаресов, Иудин,"},{"chapter":3,"first":34,"last":34,"text":"Иаковлев, Исааков, Авраамов, Фаррин, Нахоров,"},{"chapter":3,"first":35,"last":35,"text":"Серухов, Рагавов, Фалеков, Еверов, Салин,"},{"chapter":3,"first":36,"last":36,"text":"Каинанов, Арфаксадов, Симов, Ноев, Ламехов,"},{"chapter":3,"first":37,"last":37,"text":"Мафусалов, Енохов, Иаредов, Малелеилов, Каинанов,"},{"chapter":3,"first":38,"last":38,"text":"Еносов, Сифов, Адамов, Божий."},{"chapter":4,"first":1,"last":1,"text":"Иисус, исполненный Духа Святаго, возвратился от Иордана и поведен был Духом в пустыню."}]}},"schema_version":1,"translation":"syn"}
