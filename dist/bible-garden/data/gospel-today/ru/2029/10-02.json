{"calendar":"julian","date":"2029-10-02","day":{"confirmed_by":[],"items":[{"apostle":"p-3fa479b22cd54514","gospel":"p-f4dc11eb8ed755b9","kind":"ordinary"}],"period":"ordinary","uncertain":false},"passages":{"p-3fa479b22cd54514":{"audio":null,"book":50,"book_name":"Послание к Филиппийцам","display_ranges":[[1,8,1,14]],"label":"Флп 1:8–14","ranges":[[1,8,1,14]],"verses":[{"chapter":1,"first":8,"last":8,"text":"Бог — свидетель, что я люблю всех вас любовью Иисуса Христа;"},{"chapter":1,"first":9,"last":9,"text":"и молюсь о том, чтобы любовь ваша еще более и более возрастала в познании и всяком чувстве,"},{"chapter":1,"first":10,"last":10,"text":"чтобы, познавая лучшее, вы были чисты и непреткновенны в день Христов,"},{"chapter":1,"first":11,"last":11,"text":"исполнены плодов праведности Иисусом Христом, в славу и похвалу Божию."},{"chapter":1,"first":12,"last":12,"text":"Желаю, братия, чтобы вы знали, что обстоятельства мои послужили к большему успеху благовествования,"},{"chapter":1,"first":13,"last":13,"text":"так что узы мои о Христе сделались известными всей претории и всем прочим,"},{"chapter":1,"first":14,"last":14,"text":"и бо́льшая часть из братьев в Господе, ободрившись узами моими, начали с большею смелостью, безбоязненно проповедывать слово Божие."}]},"p-f4dc11eb8ed755b9":{"audio":{"chapters":[3,4],"segments":[{"begin":265.62,"chapter":3,"end":276.38},{"begin":277.12,"chapter":3,"end":285.52},{"begin":286.42,"chapter":3,"end":293.0},{"begin":293.88,"chapter":3,"end":300.66},{"begin":302.11,"chapter":3,"end":309.17},{"begin":310.22,"chapter":3,"end":317.25},{"begin":318.17,"chapter":3,"end":325.81},{"begin":326.74,"chapter":3,"end":332.77},{"begin":333.39,"chapter":3,"end":340.23},{"begin":341.09,"chapter":3,"end":347.62},{"begin":348.71,"chapter":3,"end":355.09},{"begin":356.09,"chapter":3,"end":361.82},{"begin":362.77,"chapter":3,"end":368.86},{"begin":369.58,"chapter":3,"end":375.21},{"begin":376.18,"chapter":3,"end":382.08},{"begin":382.88,"chapter":3,"end":388.7},{"begin":6.2,"chapter":4,"end":13.12}],"translation":"syn","voice":"prudovsky"},"book":42,"book_name":"Евангелие от Луки","display_ranges":[[3,23,4,1]],"label":"Лк 3:23–4:1","ranges":[[3,23,4,1]],"verses":[{"chapter":3,"first":23,"last":23,"text":"Иисус, начиная Своё служение, был лет тридцати, и был, как думали, Сын Иосифов, Илиев,"},{"chapter":3,"first":24,"last":24,"text":"Матфатов, Левиин, Мелхиев, Ианнаев, Иосифов,"},{"chapter":3,"first":25,"last":25,"text":"Маттафиев, Амосов, Наумов, Еслимов, Наггеев,"},{"chapter":3,"first":26,"last":26,"text":"Маафов, Маттафиев, Семеиев, Иосифов, Иудин,"},{"chapter":3,"first":27,"last":27,"text":"Иоаннанов, Рисаев, Зоровавелев, Салафиилев, Нириев,"},{"chapter":3,"first":28,"last":28,"text":"Мелхиев, Аддиев, Косамов, Елмодамов, Иров,"},{"chapter":3,"first":29,"last":29,"text":"Иосиев, Елиезеров, Иоримов, Матфатов, Левиин,"},{"chapter":3,"first":30,"last":30,"text":"Симеонов, Иудин, Иосифов, Ионанов, Елиакимов,"},{"chapter":3,"first":31,"last":31,"text":"Мелеаев, Маинанов, Маттафаев, Нафанов, Давидов,"},{"chapter":3,"first":32,"last":32,"text":"Иессеев, Овидов, Воозов, Салмонов, Наассонов,"},{"chapter":3,"first":33,"last":33,"text":"Аминадавов, Арамов, Есромов, Фаресов, Иудин,"},{"chapter":3,"first":34,"last":34,"text":"Иаковлев, Исааков, Авраамов, Фаррин, Нахоров,"},{"chapter":3,"first":35,"last":35,"text":"Серухов, Рагавов, Фалеков, Еверов, Салин,"},{"chapter":3,"first":36,"last":36,"text":"Каинанов, Арфаксадов, Симов, Ноев, Ламехов,"},{"chapter":3,"first":37,"last":37,"text":"Мафусалов, Енохов, Иаредов, Малелеилов, Каинанов,"},{"chapter":3,"first":38,"last":38,"text":"Еносов, Сифов, Адамов, Божий."},{"chapter":4,"first":1,"last":1,"text":"Иисус, исполненный Духа Святаго, возвратился от Иордана и поведен был Духом в пустыню."}]}},"schema_version":1,"translation":"syn"}
