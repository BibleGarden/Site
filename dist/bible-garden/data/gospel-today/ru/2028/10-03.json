{"calendar":"julian","date":"2028-10-03","day":{"confirmed_by":[],"items":[{"apostle":"p-f771f439907b17eb","gospel":"p-f4dc11eb8ed755b9","kind":"ordinary"}],"period":"ordinary","uncertain":false},"passages":{"p-f4dc11eb8ed755b9":{"audio":{"chapters":[3,4],"segments":[{"begin":265.62,"chapter":3,"end":276.38},{"begin":277.12,"chapter":3,"end":285.52},{"begin":286.42,"chapter":3,"end":293.0},{"begin":293.88,"chapter":3,"end":300.66},{"begin":302.11,"chapter":3,"end":309.17},{"begin":310.22,"chapter":3,"end":317.25},{"begin":318.17,"chapter":3,"end":325.81},{"begin":326.74,"chapter":3,"end":332.77},{"begin":333.39,"chapter":3,"end":340.23},{"begin":341.09,"chapter":3,"end":347.62},{"begin":348.71,"chapter":3,"end":355.09},{"begin":356.09,"chapter":3,"end":361.82},{"begin":362.77,"chapter":3,"end":368.86},{"begin":369.58,"chapter":3,"end":375.21},{"begin":376.18,"chapter":3,"end":382.08},{"begin":382.88,"chapter":3,"end":388.7},{"begin":6.2,"chapter":4,"end":13.12}],"translation":"syn","voice":"prudovsky"},"book":42,"book_name":"Евангелие от Луки","display_ranges":[[3,23,4,1]],"label":"Лк 3:23–4:1","ranges":[[3,23,4,1]],"verses":[{"chapter":3,"first":23,"last":23,"text":"Иисус, начиная Своё служение, был лет тридцати, и был, как думали, Сын Иосифов, Илиев,"},{"chapter":3,"first":24,"last":24,"text":"Матфатов, Левиин, Мелхиев, Ианнаев, Иосифов,"},{"chapter":3,"first":25,"last":25,"text":"Маттафиев, Амосов, Наумов, Еслимов, Наггеев,"},{"chapter":3,"first":26,"last":26,"text":"Маафов, Маттафиев, Семеиев, Иосифов, Иудин,"},{"chapter":3,"first":27,"last":27,"text":"Иоаннанов, Рисаев, Зоровавелев, Салафиилев, Нириев,"},{"chapter":3,"first":28,"last":28,"text":"Мелхиев, Аддиев, Косамов, Елмодамов, Иров,"},{"chapter":3,"first":29,"last":29,"text":"Иосиев, Елиезеров, Иоримов, Матфатов, Левиин,"},{"chapter":3,"first":30,"last":30,"text":"Симеонов, Иудин, Иосифов, Ионанов, Елиакимов,"},{"chapter":3,"first":31,"last":31,"text":"Мелеаев, Маинанов, Маттафаев, Нафанов, Давидов,"},{"chapter":3,"first":32,"last":32,"text":"Иессеев, Овидов, Воозов, Салмонов, Наассонов,"},{"chapter":3,"first":33,"last":33,"text":"Аминадавов, Арамов, Есромов, Фаресов, Иудин,"},{"chapter":3,"first":34,"last":34,"text":"Иаковлев, Исааков, Авраамов, Фаррин, Нахоров,"},{"chapter":3,"first":35,"last":35,"text":"Серухов, Рагавов, Фалеков, Еверов, Салин,"},{"chapter":3,"first":36,"last":36,"text":"Каинанов, Арфаксадов, Симов, Ноев, Ламехов,"},{"chapter":3,"first":37,"last":37,"text":"Мафусалов, Енохов, Иаредов, Малелеилов, Каинанов,"},{"chapter":3,"first":38,"last":38,"text":"Еносов, Сифов, Адамов, Божий."},{"chapter":4,"first":1,"last":1,"text":"Иисус, исполненный Духа Святаго, возвратился от Иордана и поведен был Духом в пустыню."}]},"p-f771f439907b17eb":{"audio":null,"book":49,"book_name":"Послание к Ефесянам","display_ranges":[[5,20,5,26]],"label":"Еф 5:20–26","ranges":[[5,20,5,26]],"verses":[{"chapter":5,"first":20,"last":20,"text":"благодаря всегда за все Бога и Отца, во имя Господа нашего Иисуса Христа,"},{"chapter":5,"first":21,"last":21,"text":"повинуясь друг другу в страхе Божием."},{"chapter":5,"first":22,"last":22,"text":"Жены, повинуйтесь своим мужьям, как Господу,"},{"chapter":5,"first":23,"last":23,"text":"потому что муж есть глава жены, как и Христос глава Церкви, и Он же Спаситель тела."},{"chapter":5,"first":24,"last":24,"text":"Но как Церковь повинуется Христу, так и жены своим мужьям во всем."},{"chapter":5,"first":25,"last":25,"text":"Мужья, любите своих жен, как и Христос возлюбил Церковь и предал Себя за нее,"},{"chapter":5,"first":26,"last":26,"text":"чтобы освятить ее, очистив банею водною посредством слова;"}]}},"schema_version":1,"translation":"syn"}
